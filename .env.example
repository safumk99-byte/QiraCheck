# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/quran_recitation
DB_POOL_MAX=5

# Single-operator login (required before protected APIs can be used)
APP_USERNAME=teacher
APP_PASSWORD=replace-with-at-least-12-characters
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional self-hosted Quran Arabic ASR service (see ai-service/README.md)
QURAN_ASR_SERVICE_URL=http://127.0.0.1:8791
# Set the same random secret in the ASR host as ASR_SERVICE_TOKEN (32+ characters)
QURAN_ASR_SERVICE_TOKEN=replace-with-a-random-secret-at-least-32-characters-long
